# Backend config is local-only (no secrets), so it's committed. If you switch
# to S3 with account-specific names, ignore the real files and keep *.example:
#   **/backends/*.hcl
#   !**/backends/*.hcl.example

# Local state lives under ./state/ — never commit state.
state/
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log

# Plans
tfplan
*.tfplan
plan.txt

# Real tfvars with secrets, if you ever add any. The env tfvars here are
# safe placeholders and ARE committed; uncomment if that changes.
# **/envs/*.tfvars

.DS_Store
